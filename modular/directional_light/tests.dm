#ifdef UNIT_TESTS
/datum/unit_test/directional_beam_pivot_and_armor/Run()
	var/obj/item/clothing/head/hardhat/helmet = allocate(/obj/item/clothing/head/hardhat)
	var/datum/component/directional_beam/beam = helmet.GetComponent(/datum/component/directional_beam)
	helmet.setDir(EAST)
	helmet.set_light_on(TRUE)
	beam.process()
	if(beam.beam_angle != dir2angle(EAST) || !beam.emitter)
		return Fail("Floor helmet must emit along item.dir.")
	var/atom/movable/lighting_mask/flashlight_60/mask = beam.emitter.our_mask
	var/center_offset = (world.icon_size - 256) / 2
	for(var/test_radius in list(4, 10, 5, 10))
		for(var/angle in list(-180, -90, 0, 45, 90, 180, 270))
			mask.rotate(angle)
			mask.set_radius(test_radius)
			if(abs(mask.transform.c - center_offset) > 0.01 || abs(mask.transform.f - center_offset) > 0.01)
				Fail("Cone origin moved after radius=[test_radius], angle=[angle].")
	helmet.setDir(WEST)
	beam.process()
	if(beam.beam_angle != dir2angle(WEST))
		Fail("Floor helmet must react to item rotation, not retain old cursor heading.")
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	helmet.forceMove(wearer)
	wearer.head = helmet
	beam.process()
	if(!beam.emitter || beam.emitter.source_turf != get_turf(wearer))
		Fail("Worn helmet emitter must remain on wearer turf.")
	wearer.head = null
	helmet.forceMove(get_turf(wearer))
	beam.process()
	if(!beam.emitter)
		Fail("Dropping an enabled helmet must preserve its emitter.")
	var/obj/item/clothing/suit/marine/armor = allocate(/obj/item/clothing/suit/marine)
	var/datum/component/directional_beam/armor_beam = armor.GetComponent(/datum/component/directional_beam)
	if(!armor_beam || armor.light_holder || armor.directional_beam_mouse_aim)
		return Fail("Armor must have one body-only directional controller and no legacy helper.")
	armor.forceMove(wearer)
	wearer.wear_suit = armor
	wearer.setDir(WEST)
	armor.set_light_on(TRUE)
	armor_beam.process()
	if(!armor_beam.emitter || armor_beam.beam_angle != dir2angle(WEST))
		Fail("Worn armor must emit along body facing.")
	wearer.setDir(NORTH)
	armor_beam.process()
	if(armor_beam.beam_angle != dir2angle(NORTH))
		Fail("Armor beam must follow body turns.")
	armor.set_light_on(FALSE)
	if(armor_beam.emitter)
		Fail("Armor off must remove light.")
	wearer.wear_suit = null
	armor.forceMove(get_turf(wearer))
	var/obj/item/clothing/suit/storage/marine/storage_armor = allocate(/obj/item/clothing/suit/storage/marine)
	if(storage_armor.light_holder || storage_armor.directional_beam_mouse_aim || !storage_armor.GetComponent(/datum/component/directional_beam))
		Fail("Storage armor must use the same body-only policy without a second emitter.")

/// Uses Fail directly: modular includes follow the upstream test macro undefinitions.
/datum/unit_test/directional_beam_geometry/Run()
	var/obj/item/device/flashlight/lamp = allocate(/obj/item/device/flashlight)
	var/atom/movable/lighting_mask/flashlight_60/mask = allocate(/atom/movable/lighting_mask/flashlight_60)
	mask.attached_atom = lamp
	mask.radius = 10
	mask.current_angle = -180 // NORTH
	var/turf/origin = get_turf(lamp)
	var/turf/ahead = get_step(origin, NORTH)
	var/turf/behind = get_step(origin, SOUTH)
	if(mask.turf_light_factor(ahead) <= 0 || mask.turf_light_factor(behind) != 0)
		Fail("Directional contribution must be in front, not behind.")
	if(mask.beam_weight(0, 0) != 1 || mask.beam_weight(-0.2, 0) != 0)
		Fail("Source halo must be bounded.")
	var/edge_weight = mask.beam_weight(0.5, 0.5 * tan(30))
	if(edge_weight <= 0 || edge_weight >= 1)
		Fail("Beam edge must be feathered, not binary.")
	var/baseline = ahead.luminosity
	mask.add_turf_luminosity(ahead)
	mask.add_turf_luminosity(ahead)
	if(ahead.luminosity != baseline + 1)
		Fail("Duplicate add must not accumulate luminosity.")
	mask.affecting_turfs = list(ahead, behind)
	mask.rotate(0) // SOUTH
	if(ahead.luminosity != baseline || (ahead in mask.luminous_turfs))
		Fail("Turning must release old contribution.")
	if(!(ahead in mask.affecting_turfs) || !(behind in mask.luminous_turfs))
		Fail("Turning must retain shadow dependencies and light new direction.")
	mask.remove_turf_luminosity(behind)
	mask.remove_turf_luminosity(behind)

/datum/unit_test/directional_beam_lifecycle/Run()
	var/obj/item/device/flashlight/lamp = allocate(/obj/item/device/flashlight)
	var/datum/component/directional_beam/beam = lamp.GetComponent(/datum/component/directional_beam)
	if(!beam || lamp.GetComponent(/datum/component/overlay_lighting))
		return Fail("Torch must have exactly the directional controller, not the old overlay.")
	lamp.set_light_on(TRUE)
	if(!beam.emitter || beam.emitter.light_range != 10)
		Fail("Enabled torch must create the validated range10 emitter.")
	lamp.set_light_on(FALSE)
	if(beam.emitter)
		Fail("Off must release emitter immediately.")
	var/obj/item/device/flashlight/flare/flare = allocate(/obj/item/device/flashlight/flare)
	if(flare.GetComponent(/datum/component/directional_beam) || !flare.GetComponent(/datum/component/overlay_lighting))
		Fail("Flare must retain its circular light.")
	var/obj/item/clothing/head/helmet/marine/veteran/pmc/enclosed/helmet = allocate(/obj/item/clothing/head/helmet/marine/veteran/pmc/enclosed)
	if(helmet.light_holder || !helmet.GetComponent(/datum/component/directional_beam))
		Fail("PMC helmet must not create a second legacy light holder.")
/datum/unit_test/directional_beam_movement/Run()
	var/obj/item/clothing/head/hardhat/helmet = allocate(/obj/item/clothing/head/hardhat)
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	helmet.forceMove(wearer)
	wearer.head = helmet
	helmet.set_light_on(TRUE)
	var/datum/component/directional_beam/beam = helmet.GetComponent(/datum/component/directional_beam)
	beam.process()
	if(!beam.emitter)
		return Fail("Movement test requires an enabled helmet emitter.")
	wearer.glide_size = 8
	var/turf/destination = get_step(wearer, NORTH)
	wearer.forceMove(destination)
	// Intentionally do not process the component: native movement must suffice.
	if(beam.emitter.source_turf != destination || get_turf(beam.emitter.mask_holder) != destination)
		Fail("Beam position must update before the next subsystem tick.")
	if(beam.emitter.mask_holder.glide_size != wearer.glide_size)
		Fail("Adjacent movement must match carrier glide.")
	var/turf/far_destination = get_step(get_step(destination, SOUTH), SOUTH)
	wearer.forceMove(far_destination)
	if(get_turf(beam.emitter.mask_holder) != far_destination || beam.emitter.mask_holder.glide_size != INFINITY)
		Fail("Long-distance movement must snap to the carrier.")
/datum/unit_test/directional_beam_event_queue/Run()
	for(var/count in list(1, 10, 30))
		var/list/beams = list()
		for(var/index in 1 to count)
			var/obj/item/device/flashlight/lamp = allocate(/obj/item/device/flashlight)
			lamp.set_light_on(TRUE)
			var/datum/component/directional_beam/beam = lamp.GetComponent(/datum/component/directional_beam)
			beams += beam
			if(beam.datum_flags & DF_ISPROCESSING)
				Fail("Stationary light must not remain in processing after activation.")
			for(var/event_index in 1 to 100)
				beam.wake()
			var/entries = 0
			for(var/datum/entry as anything in SSdirectional_light.processing)
				if(entry == beam)
					entries++
			if(entries != 1)
				Fail("100 events must coalesce to one queue entry per beam.")
			if(beam.process() != PROCESS_KILL)
				Fail("Updated beam must sleep instead of polling.")
			STOP_PROCESSING(SSdirectional_light, beam)
			lamp.set_light_on(FALSE)
			beam.wake()
			if(beam.datum_flags & DF_ISPROCESSING)
				Fail("Off lamp must not enqueue work.")
		log_test("Directional queue: [count] lamps, [count * 100] events -> [count] entries; idle persistent entries 0 (old polling [count * 10]/second).")
	var/obj/item/clothing/head/hardhat/helmet = allocate(/obj/item/clothing/head/hardhat)
	helmet.set_light_on(TRUE)
	var/datum/component/directional_beam/beam = helmet.GetComponent(/datum/component/directional_beam)
	helmet.setDir(EAST)
	if(!(beam.datum_flags & DF_ISPROCESSING))
		Fail("Floor turn must wake a sleeping beam.")
	beam.process()
	if(beam.beam_angle != dir2angle(EAST))
		Fail("Floor turn must apply new heading after signal.")
	var/obj/item/storage/backpack/bag = allocate(/obj/item/storage/backpack)
	helmet.forceMove(bag)
	if(beam.process() != PROCESS_KILL || beam.emitter)
		Fail("Stored beam must release emitter and sleep.")
	STOP_PROCESSING(SSdirectional_light, beam)
	helmet.forceMove(get_turf(bag))
	if(!(beam.datum_flags & DF_ISPROCESSING))
		Fail("Extraction must wake beam without polling.")
	beam.process()
	if(!beam.emitter)
		Fail("Extracted beam must regain emitter.")
	STOP_PROCESSING(SSdirectional_light, beam)
	helmet.set_light_color("#abcdef")
	if(!(beam.datum_flags & DF_ISPROCESSING))
		Fail("Light color setter must wake sleeping beam.")
	beam.process()
	if(beam.emitter.light_color != "#abcdef")
		Fail("Deferred light update must read the assigned color.")
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human)
	helmet.forceMove(wearer)
	wearer.head = helmet
	beam.process()
	STOP_PROCESSING(SSdirectional_light, beam)
	wearer.setDir(WEST)
	if(!(beam.datum_flags & DF_ISPROCESSING))
		Fail("NPC facing must wake held/worn light.")
	beam.process()
	if(beam.beam_angle != dir2angle(WEST))
		Fail("NPC facing must apply without mouse.")
	wearer.head = null
	helmet.forceMove(get_turf(wearer))
	beam.process()
	STOP_PROCESSING(SSdirectional_light, beam)
	wearer.setDir(EAST)
	if(beam.datum_flags & DF_ISPROCESSING)
		Fail("Old wearer must no longer wake a dropped light.")
#endif
